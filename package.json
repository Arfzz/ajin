{
  "name": "ajin-sibi-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AJIN - Aplikasi Jembatan Bahasa Isyarat dan Narasi (SIBI Real-Time Computer Vision & Interactive Motion)",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run server\" \"npm run client\"",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "google-auth-library": "^11.3.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
