# ==============================================================================
# AJIN SIBI Environment Variables (Backend & Vercel Full-Stack)
# ==============================================================================
PORT=5001
NODE_ENV=development

# URL Aplikasi (opsional di Vercel karena terdeteksi otomatis dari domain Vercel)
# Lokal:  http://localhost:5173
# Vercel: https://ajin-anda.vercel.app
CLIENT_URL=http://localhost:5173

# Supabase Credentials (Gunakan Service Role / Secret Key di Backend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key
# Opsional: paksa model tertentu (default otomatis memakai gemini-3.8-flash & gemini-3.7-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Lokal:  http://localhost:8000/auth/google/callback
# Vercel: https://ajin-anda.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
